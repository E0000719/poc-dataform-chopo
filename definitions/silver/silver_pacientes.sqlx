config {
  type: "incremental",
  uniqueKey: ["id_paciente"],
  schema: "silver",
  name: "pacientes",
  description: "Tabla depurada de pacientes con datos personales normalizados.",
  columns: dictionary.get_column_descriptions([
    { from: "paciente_id",      to: "id_paciente" },
    { from: "nombre",           to: "nombre", description: "Nombre(s) del paciente" },
    { from: "apellido",         to: "apellido" },
    { from: "email",            to: "email" },
    { from: "genero",           to: "genero" },
    { from: "fecha_nacimiento", to: "fecha_nacimiento" },
    { from: "fecha_registro",   to: "fecha_registro" }
  ]),
  tags: ["silver", "pacientes"],
  assertions: {
    uniqueKey: ["id_paciente"],
    nonNull: ["id_paciente"]
  },
  bigquery: {
    clusterBy: ["genero"]
  }
}

js {
  const dq_fields = require("includes/quality.js");
}

WITH bronze AS (
  SELECT *
  FROM ${ref({ schema: "bronze", name: "pacientes" })}

  -- fecha_registro es append-only (no hay columna de "modificado"), así que sirve como cursor
  -- incremental solo para altas nuevas; ediciones tardías de un paciente ya cargado no se recapturan.
  ${when(incremental(), `WHERE ${dq_fields.safeCastTimestamp("fecha_registro")} > (SELECT MAX(fecha_registro) FROM ${self()})`)}
)

SELECT
  ${dq_fields.safeCast("paciente_id", "INT64")} AS id_paciente,

  ${dq_fields.trimToNull("nombre")} AS nombre,

  ${dq_fields.trimToNull("apellido")} AS apellido,

  -- Email normalizado a minúsculas para comparaciones/joins consistentes.
  ${dq_fields.lowerToNull("email")} AS email,

  -- Género acotado a valores válidos (M/F); cualquier otro valor cae a NULL en vez de ensuciar el dato.
  CASE
    WHEN ${dq_fields.trimUpperToNull("genero")} IN ('M', 'F') THEN ${dq_fields.trimUpperToNull("genero")}
    ELSE NULL
  END AS genero,

  ${dq_fields.safeCastDate("fecha_nacimiento")} AS fecha_nacimiento,

  ${dq_fields.safeCastTimestamp("fecha_registro")} AS fecha_registro

FROM bronze
QUALIFY ${dq_fields.keepLatestByKey(["paciente_id"], "fecha_registro")}
