config {
  type: "incremental",
  uniqueKey: ["id_sucursal"],
  schema: "silver",
  name: "sucursales",
  description: "Catálogo depurado y normalizado de sucursales.",
  columns: dictionary.get_column_descriptions([
    { from: "sucursal_id",    to: "id_sucursal" },
    { from: "nombre",         to: "nombre", description: "Nombre comercial de la sucursal de atención" },
    { from: "ciudad",         to: "ciudad" },
    { from: "estado",         to: "estado", description: "Estado geográfico (entidad federativa) donde se ubica la sucursal" },
    { from: "fecha_apertura", to: "fecha_apertura" }
  ]),
  tags: ["silver", "sucursales"],
  assertions: {
    uniqueKey: ["id_sucursal"],
    nonNull: ["id_sucursal"]
  },
  bigquery: {
    clusterBy: ["estado", "ciudad"]
  }
}

js {
  const dq_fields = require("includes/quality.js");
}

WITH bronze AS (
  SELECT *
  FROM ${ref({ schema: "bronze", name: "sucursales" })}
)

SELECT
  ${dq_fields.safeCast("sucursal_id", "INT64")} AS id_sucursal,

  ${dq_fields.trimToNull("nombre")} AS nombre,

  ${dq_fields.trimToNull("ciudad")} AS ciudad,

  ${dq_fields.trimToNull("estado")} AS estado,

  ${dq_fields.safeCastDate("fecha_apertura")} AS fecha_apertura

FROM bronze

-- Al igual que estudios, sucursales es un catálogo sin columna de auditoría: se reprocesa
-- completo cada corrida (el upsert lo resuelve uniqueKey en config) y el QUALIFY solo
-- blinda contra duplicados accidentales de la llave.
QUALIFY ROW_NUMBER() OVER (PARTITION BY sucursal_id ORDER BY sucursal_id) = 1
