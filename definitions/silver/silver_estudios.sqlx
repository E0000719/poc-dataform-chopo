config {
  type: "incremental",
  uniqueKey: ["id_estudio"],
  schema: "silver",
  name: "estudios",
  description: "Catálogo depurado y normalizado de estudios médicos.",
  columns: dictionary.get_column_descriptions([
    { from: "estudio_id",       to: "id_estudio" },
    { from: "codigo_estudio",   to: "codigo_estudio" },
    { from: "nombre_estudio",   to: "nombre_estudio" },
    { from: "categoria",        to: "categoria" },
    { from: "precio",           to: "precio" },
    { from: "unidad_medida",    to: "unidad_medida" },
    { from: "rango_referencia", to: "rango_referencia" },
    { to: "fecha_carga_silver", description: "Marca de tiempo UTC indicando cuándo Dataform cargó el registro en la capa silver" }
  ]),
  tags: ["silver", "estudios"],
  assertions: {
    uniqueKey: ["id_estudio"],
    nonNull: ["id_estudio"]
  },
  bigquery: {
    clusterBy: ["categoria"]
  }
}

js {
  const dq_fields = require("includes/quality.js");
}

WITH bronze AS (
  SELECT *
  FROM ${ref({ schema: "bronze", name: "estudios" })}
)

SELECT
  ${dq_fields.safeCast("estudio_id", "INT64")} AS id_estudio,

  ${dq_fields.trimUpperToNull("codigo_estudio")} AS codigo_estudio,

  ${dq_fields.trimToNull("nombre_estudio")} AS nombre_estudio,

  ${dq_fields.trimUpperToNull("categoria")} AS categoria,

  ${dq_fields.safeCast("precio", "NUMERIC")} AS precio,

  ${dq_fields.trimUpperToNull("unidad_medida")} AS unidad_medida,

  ${dq_fields.trimToNull("rango_referencia")} AS rango_referencia,

  CURRENT_TIMESTAMP() AS fecha_carga_silver

FROM bronze

QUALIFY ROW_NUMBER() OVER (PARTITION BY estudio_id ORDER BY estudio_id) = 1
