config {
  type: "incremental",
  uniqueKey: ["id_resultado"],
  schema: "silver",
  name: "resultados",
  description: "Resultados cuantificables e individuales de estudios asociados a órdenes.",
  columns: dictionary.get_column_descriptions([
    { from: "resultado_id",     to: "id_resultado" },
    { from: "orden_id",         to: "id_orden" },
    { from: "estudio_id",       to: "id_estudio" },
    { from: "valor_resultado",  to: "valor_resultado" },
    { from: "fecha_resultado",  to: "fecha_resultado" }
  ]),
  tags: ["silver", "resultados"],
  assertions: {
    uniqueKey: ["id_resultado"],
    nonNull: ["id_resultado", "id_orden", "id_estudio"]
  },
  bigquery: {
    partitionBy: "DATE(fecha_resultado)",
    clusterBy: ["id_orden", "id_estudio"]
  }
}

js {
  const dq_fields = require("includes/quality.js");
}

WITH bronze AS (
  SELECT *
  FROM ${ref({ schema: "bronze", name: "resultados" })}

  ${when(incremental(), `WHERE ${dq_fields.safeCastTimestamp("fecha_resultado")} > (SELECT MAX(fecha_resultado) FROM ${self()})`)}
)

SELECT
  ${dq_fields.safeCast("resultado_id", "INT64")} AS id_resultado,

  ${dq_fields.safeCast("orden_id", "INT64")} AS id_orden,

  ${dq_fields.safeCast("estudio_id", "INT64")} AS id_estudio,

  -- se recorta espacios y se colapsa vacío a NULL.
  ${dq_fields.trimToNull("valor_resultado")} AS valor_resultado,

  ${dq_fields.safeCastTimestamp("fecha_resultado")} AS fecha_resultado

FROM bronze
QUALIFY ${dq_fields.keepLatestByKey(["resultado_id"], "fecha_resultado")}
