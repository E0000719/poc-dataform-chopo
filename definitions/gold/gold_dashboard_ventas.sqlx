config {
  type: "table",
  schema: "gold",
  name: "dashboard_ventas",
  description: "Dataset consolidado para tableros ejecutivos con detalle de ventas, volumen de estudios e ingresos por cliente.",
  columns: {
    id_orden: "Identificador único de la orden de laboratorio",
    fecha_orden: "Fecha y hora en que se levantó la orden",
    estatus_orden: "Estado operativo de la orden",
    id_sucursal: "Identificador único de la sucursal de atención",
    nombre_sucursal: "Nombre comercial de la sucursal",
    ciudad_sucursal: "Ciudad donde se ubica la sucursal",
    estado_sucursal: "Estado geográfico donde se ubica la sucursal",
    id_paciente: "Identificador único del paciente",
    genero_paciente: "Género biológico del paciente",
    edad_paciente_al_ordenar: "Edad calculada del paciente al momento de crear la orden",
    id_estudio: "Identificador único del estudio médico",
    codigo_estudio: "Código clave del estudio",
    nombre_estudio: "Nombre oficial del estudio médico",
    categoria_estudio: "Categoría médica a la que pertenece el estudio",
    ingreso_generado: "Monto total del estudio en pesos mexicanos (MXN)",
    ts_dataform_process: "Marca de tiempo UTC indicando cuándo Dataform procesó el registro"
  },
  tags: ["gold", "dashboard"],
  assertions: {
    uniqueKey: ["id_orden", "id_estudio"]
  },
  bigquery: {
    partitionBy: "DATE(fecha_orden)",
    clusterBy: ["estado_sucursal", "categoria_estudio"]
  }
}

WITH base AS (

    SELECT
        o.id_orden,
        o.fecha_orden,
        o.estatus AS estatus_orden,

        -- Dimensiones de Sucursal
        s.id_sucursal,
        s.nombre AS nombre_sucursal,
        s.ciudad AS ciudad_sucursal,
        s.estado AS estado_sucursal,

        -- Dimensiones del Paciente
        p.id_paciente,
        p.genero AS genero_paciente,
        DATE_DIFF(DATE(o.fecha_orden), p.fecha_nacimiento, YEAR) AS edad_paciente_al_ordenar,

        -- Dimensiones del Estudio y Resultados
        e.id_estudio,
        e.codigo_estudio,
        e.nombre_estudio,
        e.categoria AS categoria_estudio,
        COALESCE(e.precio, 0) AS precio_estudio

    FROM ${ref("silver", "ordenes")} AS o
    INNER JOIN ${ref("silver", "sucursales")} AS s
        ON o.id_sucursal = s.id_sucursal
    LEFT JOIN ${ref("silver", "pacientes")} AS p
        ON o.id_paciente = p.id_paciente
    LEFT JOIN ${ref("silver", "resultados")} AS r
        ON o.id_orden = r.id_orden
    LEFT JOIN ${ref("silver", "estudios")} AS e
        ON r.id_estudio = e.id_estudio

)

SELECT
    id_orden,
    fecha_orden,
    estatus_orden,
    id_sucursal,
    nombre_sucursal,
    ciudad_sucursal,
    estado_sucursal,
    id_paciente,
    genero_paciente,
    edad_paciente_al_ordenar,
    id_estudio,
    codigo_estudio,
    nombre_estudio,
    categoria_estudio,
    precio_estudio AS ingreso_generado,

    CURRENT_TIMESTAMP() AS ts_dataform_process

FROM base