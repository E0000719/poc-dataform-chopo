config {
  type: "table",
  schema: "gold",
  name: "dashboard_ventas",
  description: "Dataset consolidado para tableros ejecutivos con detalle de ventas, volumen de estudios e ingresos por cliente.",
  columns: dictionary.get_column_descriptions([
    "id_orden",
    "fecha_orden",
    { to: "estatus_orden", description: "Estado operativo de la orden (ej. Completado, Pendiente, Cancelado)" },
    "id_sucursal",
    "nombre_sucursal",
    { to: "ciudad_sucursal", description: "Ciudad donde se ubica la sucursal" },
    { to: "estado_sucursal", description: "Estado geográfico (entidad federativa) donde se ubica la sucursal" },
    "id_paciente",
    { to: "genero_paciente", description: "Género biológico registrado del paciente" },
    { to: "edad_paciente_al_ordenar", description: "Edad calculada del paciente al momento de crear la orden" },
    "id_estudio",
    "codigo_estudio",
    "nombre_estudio",
    { to: "categoria_estudio", description: "Categoría médica a la que pertenece el estudio (ej. Hematología, Química Clínica)" },
    { to: "ingreso_generado", description: "Monto total del estudio en pesos mexicanos (MXN)" },
    "ts_dataform_process"
  ]),
  tags: ["gold", "dashboard"],
  assertions: {
    uniqueKey: ["id_orden", "id_estudio"]
  },
  bigquery: {
    partitionBy: "DATE(fecha_orden)",
    clusterBy: ["estado_sucursal", "categoria_estudio"]
  }
}

WITH estudios_por_orden AS (

    -- resultados vive a grano de analito: una orden+estudio puede tener varios resultados.
    -- Se deduplica aquí a grano (id_orden, id_estudio) para no inflar el join de abajo.
    SELECT DISTINCT id_orden, id_estudio
    FROM ${ref("silver", "resultados")}

),

base AS (

    SELECT
        o.id_orden,
        o.fecha_orden,
        o.estado AS estatus_orden,

        -- Dimensiones de Sucursal
        s.id_sucursal,
        s.nombre AS nombre_sucursal,
        s.ciudad AS ciudad_sucursal,
        s.estado AS estado_sucursal,

        -- Dimensiones del Paciente
        p.id_paciente,
        p.genero AS genero_paciente,
        DATE_DIFF(DATE(o.fecha_orden), p.fecha_nacimiento, YEAR) AS edad_paciente_al_ordenar,

        -- Dimensiones del Estudio y Resultados
        e.id_estudio,
        e.codigo_estudio,
        e.nombre_estudio,
        e.categoria AS categoria_estudio,
        COALESCE(e.precio, 0) AS precio_estudio

    FROM ${ref("silver", "ordenes")} AS o
    INNER JOIN ${ref("silver", "sucursales")} AS s
        ON o.id_sucursal = s.id_sucursal
    LEFT JOIN ${ref("silver", "pacientes")} AS p
        ON o.id_paciente = p.id_paciente
    LEFT JOIN estudios_por_orden AS r
        ON o.id_orden = r.id_orden
    LEFT JOIN ${ref("silver", "estudios")} AS e
        ON r.id_estudio = e.id_estudio

)

SELECT
    id_orden,
    fecha_orden,
    estatus_orden,
    id_sucursal,
    nombre_sucursal,
    ciudad_sucursal,
    estado_sucursal,
    id_paciente,
    genero_paciente,
    edad_paciente_al_ordenar,
    id_estudio,
    codigo_estudio,
    nombre_estudio,
    categoria_estudio,
    precio_estudio AS ingreso_generado,

    CURRENT_TIMESTAMP() AS ts_dataform_process

FROM base